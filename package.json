{
  "name": "razbor-partiy",
  "productName": "Разбор партий",
  "version": "1.1.0",
  "description": "Разбор шахматных партий с chess.com",
  "main": "./out/main/index.js",
  "author": "Arsen",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "postinstall": "electron-builder install-app-deps",
    "fetch:stockfish": "node scripts/fetch-stockfish.mjs",
    "fetch:openings": "node scripts/fetch-openings.mjs",
    "verify:guides": "tsx scripts/verify-guides.ts",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run icon && npm run build && electron-builder --mac --arm64",
    "dist:dir": "npm run build && electron-builder --dir",
    "analyze:fixture": "tsx scripts/analyze-fixture.ts",
    "eval:line": "tsx scripts/eval-line.ts",
    "dist:mac": "npm run icon && npm run build && electron-builder --mac --arm64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "verify:course": "tsx scripts/verify-course.ts",
    "build:compositions": "tsx scripts/build-compositions.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "better-sqlite3": "^13.0.3",
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
